---
import { config, url } from '../../lib/config';
const s = config.sections.produits!;
---
<section id="produits" class="section">
  <div class="conteneur">
    <h2>{s.titre}</h2>
    {s.intro && <p class="section__intro">{s.intro}</p>}
    <div class="grille grille--4 defilant">
      {s.items.map((item) => (
        <article class="produit">
          {item.image && (
            <div class="visuel visuel--zoom">
              <img src={url(item.image.src)} alt={item.image.alt} width="800" height="600" loading="lazy" />
            </div>
          )}
          <h3>{item.titre}</h3>
          <p>{item.texte}</p>
        </article>
      ))}
    </div>
    {s.items.length > 1 && <p class="defilant__indice" aria-hidden="true">Faites glisser pour voir la suite →</p>}
  </div>
</section>

<style>
  .produit { background: #fff; border-radius: var(--rayon); padding: 10px 10px 18px; box-shadow: var(--ombre); }
  .produit h3 { margin: 14px 8px .3em; }
  .produit p { margin: 0 8px; color: var(--texte-doux); }
  .produit .visuel { border-radius: var(--rayon-s); }

</style>
