---
import { config } from '../../lib/config';
const s = config.sections.horaires!;
---
<section id="horaires" class="section">
  <div class="conteneur horaires">
    <h2>{s.titre}</h2>
    <table class="carte">
      <caption class="sr">Horaires d'ouverture</caption>
      <tbody>
        {s.semaine.map((j) => (
          <tr data-jour={j.jour}>
            <th scope="row">{j.jour}</th>
            <td>{j.plages.length ? j.plages.join(' · ') : 'Fermé'}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {s.note && <p class="horaires__note">{s.note}</p>}
  </div>
</section>

<script is:inline>
  // Surligne le jour courant (heure de Paris)
  (function () {
    var jours = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
    var nom = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', timeZone: 'Europe/Paris' }).format(new Date());
    var jour = nom.charAt(0).toUpperCase() + nom.slice(1);
    if (jours.indexOf(jour) === -1) return;
    var ligne = document.querySelector('#horaires tr[data-jour="' + jour + '"]');
    if (ligne) ligne.classList.add('aujourdhui');
  })();
</script>

<style>
  .horaires { max-width: 640px; }
  table { width: 100%; border-collapse: collapse; padding: 8px 24px; }
  th, td { padding: 12px 8px; text-align: left; border-bottom: 1px solid color-mix(in srgb, var(--principale) 10%, transparent); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  td { text-align: right; }
  :global(tr.aujourdhui) { color: var(--principale); font-weight: 700; }
  :global(tr.aujourdhui) th::after { content: ' · aujourd\'hui'; font-weight: 400; font-size: .85em; color: var(--accent); }
  .horaires__note { margin-top: 16px; font-size: .9rem; color: color-mix(in srgb, var(--texte) 70%, transparent); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
