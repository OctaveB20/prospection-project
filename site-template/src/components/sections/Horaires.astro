---
import { config } from '../../lib/config';
const s = config.sections.horaires!;
const semaine = JSON.stringify(s.semaine);
---
<section id="horaires" class="section">
  <div class="conteneur horaires">
    <div class="horaires__tete">
      <h2>{s.titre}</h2>
      <p class="pastille" data-ouverture hidden><span class="pastille__point"></span><span data-ouverture-texte></span></p>
    </div>
    <div class="carte horaires__carte" data-semaine={semaine}>
      <table>
        <caption class="sr">Horaires d'ouverture</caption>
        <tbody>
          {s.semaine.map((j) => (
            <tr data-jour={j.jour}>
              <th scope="row">{j.jour}</th>
              <td>{j.plages.length ? j.plages.map((p) => <span>{p}</span>) : <span class="ferme">Fermé</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {s.note && <p class="horaires__note">{s.note}</p>}
  </div>
</section>

<script is:inline>
  // Jour courant surligné + statut « Ouvert / Fermé » en direct, à l'heure de Paris.
  // Remplit aussi les pastilles [data-ouverture] ailleurs dans la page (accueil).
  (function () {
    var bloc = document.querySelector('#horaires [data-semaine]');
    if (!bloc) return;
    var semaine = JSON.parse(bloc.getAttribute('data-semaine'));
    var noms = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
    var parts = {};
    new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
      .formatToParts(new Date()).forEach(function (p) { parts[p.type] = p.value; });
    var idx = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(parts.weekday);
    var maintenant = parseInt(parts.hour, 10) * 60 + parseInt(parts.minute, 10);
    var minutes = function (t) { var m = t.trim().match(/(\d{1,2})h(\d{2})?/); return m ? +m[1] * 60 + (+(m[2] || 0)) : null; };
    var plagesDu = function (nom) {
      var j = semaine.filter(function (x) { return x.jour === nom; })[0];
      return (j ? j.plages : []).map(function (p) {
        var b = p.split(/[–-]/); return { de: minutes(b[0]), a: minutes(b[1] || ''), txt: (b[0] || '').trim(), fin: (b[1] || '').trim() };
      }).filter(function (p) { return p.de !== null && p.a !== null; });
    };

    var ligne = bloc.querySelector('tr[data-jour="' + noms[idx] + '"]');
    if (ligne) ligne.classList.add('aujourdhui');

    var texte, ouvert = false;
    var aujourdHui = plagesDu(noms[idx]);
    var enCours = aujourdHui.filter(function (p) { return maintenant >= p.de && maintenant < p.a; })[0];
    if (enCours) {
      ouvert = true; texte = 'Ouvert · ferme à ' + enCours.fin;
    } else {
      var plusTard = aujourdHui.filter(function (p) { return p.de > maintenant; })[0];
      if (plusTard) texte = 'Fermé · ouvre à ' + plusTard.txt;
      for (var k = 1; !texte && k <= 7; k++) {
        var nom = noms[(idx + k) % 7], p = plagesDu(nom)[0];
        if (p) texte = 'Fermé · ouvre ' + (k === 1 ? 'demain' : nom.toLowerCase()) + ' à ' + p.txt;
      }
    }
    if (!texte) return;
    document.querySelectorAll('[data-ouverture]').forEach(function (el) {
      el.querySelector('[data-ouverture-texte]').textContent = texte;
      el.classList.add(ouvert ? 'pastille--ouvert' : 'pastille--ferme');
      el.hidden = false;
    });
  })();
</script>

<style>
  .horaires { max-width: 680px; }
  .horaires__tete { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; margin-bottom: 1rem; }
  .horaires__tete h2 { margin: 0; }
  .horaires__tete .pastille[hidden] { display: none; }
  .horaires__carte { padding: 6px 20px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 14px 4px; text-align: left; border-bottom: 1px solid color-mix(in srgb, var(--principale) 9%, transparent); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  th { font-weight: 600; }
  td { text-align: right; font-variant-numeric: tabular-nums; }
  td span { display: inline-block; white-space: nowrap; }
  td span + span { margin-left: .9em; }
  td .ferme { color: var(--texte-doux); }
  :global(tr.aujourdhui) th, :global(tr.aujourdhui) td { color: var(--principale); font-weight: 700; }
  :global(tr.aujourdhui) th::after { content: ' · aujourd\'hui'; font-weight: 500; font-size: .85em; color: var(--accent-texte); }
  .horaires__note { margin-top: 16px; font-size: .92rem; color: var(--texte-doux); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 480px) {
    td span { display: block; }
    td span + span { margin-left: 0; margin-top: 2px; }
  }
</style>
