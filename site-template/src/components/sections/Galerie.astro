---
import { config, url } from '../../lib/config';
const s = config.sections.galerie!;
---
<section id="galerie" class="section">
  <div class="conteneur">
    <h2>{s.titre}</h2>
    {s.intro && <p class="section__intro">{s.intro}</p>}
    <ul class="galerie defilant">
      {s.images.map((img, i) => (
        <li>
          <figure>
            <button class="galerie__ouvrir visuel visuel--zoom" type="button" data-index={i} aria-label={`Agrandir : ${img.legende ?? img.alt}`}>
              <img src={url(img.src)} alt={img.alt} width="800" height="600" loading="lazy" />
            </button>
            {img.legende && <figcaption>{img.legende}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
    {s.images.length > 1 && <p class="defilant__indice" aria-hidden="true">Faites glisser · touchez une photo pour l'agrandir</p>}
  </div>

  <dialog class="visionneuse" aria-label="Photo agrandie">
    <div class="visionneuse__cadre">
      <img alt="" />
      <p class="visionneuse__legende"></p>
    </div>
    <button class="visionneuse__fermer" type="button" aria-label="Fermer">×</button>
    <button class="visionneuse__nav visionneuse__prec" type="button" aria-label="Photo précédente">‹</button>
    <button class="visionneuse__nav visionneuse__suiv" type="button" aria-label="Photo suivante">›</button>
    <p class="visionneuse__compteur" aria-live="polite"></p>
  </dialog>
</section>

<script is:inline>
  // Visionneuse : touche ou clic pour agrandir, glisser ou flèches pour naviguer, Échap pour fermer.
  (function () {
    var section = document.getElementById('galerie');
    var dlg = section && section.querySelector('.visionneuse');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    var vignettes = Array.prototype.slice.call(section.querySelectorAll('.galerie__ouvrir'));
    var img = dlg.querySelector('img'), legende = dlg.querySelector('.visionneuse__legende');
    var compteur = dlg.querySelector('.visionneuse__compteur'), actuel = 0;
    var afficher = function (i) {
      actuel = (i + vignettes.length) % vignettes.length;
      var source = vignettes[actuel].querySelector('img');
      var fig = vignettes[actuel].closest('figure').querySelector('figcaption');
      img.src = source.currentSrc || source.src; img.alt = source.alt;
      legende.textContent = fig ? fig.textContent : '';
      compteur.textContent = (actuel + 1) + ' / ' + vignettes.length;
    };
    vignettes.forEach(function (v, i) {
      v.addEventListener('click', function () { afficher(i); dlg.showModal(); document.documentElement.classList.add('fige'); });
    });
    dlg.addEventListener('close', function () { document.documentElement.classList.remove('fige'); vignettes[actuel].focus({ preventScroll: true }); });
    dlg.querySelector('.visionneuse__fermer').addEventListener('click', function () { dlg.close(); });
    dlg.querySelector('.visionneuse__prec').addEventListener('click', function () { afficher(actuel - 1); });
    dlg.querySelector('.visionneuse__suiv').addEventListener('click', function () { afficher(actuel + 1); });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') afficher(actuel - 1);
      if (e.key === 'ArrowRight') afficher(actuel + 1);
    });
    var x0 = null;
    dlg.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 45) afficher(actuel + (dx < 0 ? 1 : -1));
    }, { passive: true });
  })();
</script>

<style>
  .galerie {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 18px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  figure { margin: 0; }
  figcaption { margin-top: 10px; font-size: .92rem; color: var(--texte-doux); }
  .galerie__ouvrir { display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; touch-action: manipulation; box-shadow: var(--ombre); }

  :global(html.fige) { overflow: hidden; }
  .visionneuse {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh;
    margin: 0; padding: 0; border: 0; background: transparent; color: #fff;
  }
  .visionneuse::backdrop { background: rgba(20, 12, 12, .88); backdrop-filter: blur(6px); }
  .visionneuse[open] { display: grid; place-items: center; animation: apparition .3s var(--ease); }
  .visionneuse__cadre { width: min(92vw, 1000px); pointer-events: none; }
  .visionneuse__cadre img { width: 100%; max-height: 78dvh; object-fit: contain; border-radius: var(--rayon); background: var(--clair); }
  .visionneuse__legende { text-align: center; margin: 14px 0 0; font-size: 1rem; }
  .visionneuse__compteur { position: absolute; top: max(16px, env(safe-area-inset-top)); left: 20px; margin: 0; font-size: .9rem; opacity: .8; }
  .visionneuse button {
    position: absolute; width: 52px; height: 52px; border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .14); color: #fff; font-size: 2rem; line-height: 1;
    cursor: pointer; touch-action: manipulation; transition: background-color .2s var(--ease);
  }
  .visionneuse button:hover { background: rgba(255, 255, 255, .26); }
  .visionneuse__fermer { top: max(12px, env(safe-area-inset-top)); right: 12px; }
  .visionneuse__nav { top: 50%; transform: translateY(-50%); }
  .visionneuse__prec { left: 12px; }
  .visionneuse__suiv { right: 12px; }
  @media (max-width: 760px) {
    .visionneuse__nav { top: auto; bottom: max(20px, env(safe-area-inset-bottom)); transform: none; }
    .visionneuse__prec { left: calc(50% - 64px); }
    .visionneuse__suiv { right: calc(50% - 64px); }
  }
  @keyframes apparition { from { opacity: 0; transform: scale(.98); } to { opacity: 1; transform: none; } }
</style>
