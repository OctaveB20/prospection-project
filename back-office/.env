# Copie ce fichier en .env puis remplis tes propres clés (jamais commitées).

# Google Cloud > APIs & Services : activer « Places API (New) » et « PageSpeed Insights API »,
# créer une clé restreinte à ces deux API. Mettre une alerte budget sur le compte de facturation.
GOOGLE_PLACES_API_KEY = "AIzaSyBO-mrYmM_2o7DAX9ci8pHDXZ3m-qiSVgA"
# Optionnelle (PageSpeed marche sans clé, mais avec une limite basse). Peut être la même clé.
PAGESPEED_API_KEY=

# Garde-fous quota Text Search Enterprise (1 000 gratuits / mois chez Google).
PLACES_MONTHLY_LIMIT=900
PLACES_DAILY_LIMIT=60

# Ne pas rescanner un même métier + zone avant N jours.
RESCAN_DAYS=30
# Durée max de conservation des données Google en cache (seul le place_id est gardé au-delà).
CACHE_DAYS=30
