# Copie ce fichier en .env puis remplis tes propres clés (jamais commitées).

# Google Cloud > APIs & Services : activer « Places API (New) », créer une clé
# (restriction d'application : Aucune ; restriction d'API : Places API (New) uniquement).
# Mettre une alerte budget (1 €) et un quota journalier Text Search.
GOOGLE_PLACES_API_KEY=
# Optionnelle : PageSpeed marche sans clé (limite basse). Sinon, une 2e clé restreinte à « PageSpeed Insights API ».
PAGESPEED_API_KEY=

# Garde-fous quota Text Search Enterprise (1 000 gratuits / mois chez Google).
PLACES_MONTHLY_LIMIT=900
PLACES_DAILY_LIMIT=60

# Ne pas rescanner un même métier + zone avant N jours.
RESCAN_DAYS=30
# Durée max de conservation des données Google en cache (seul le place_id est gardé au-delà).
CACHE_DAYS=30

# --- En ligne (Streamlit Community Cloud) : à mettre dans Settings > Secrets, pas ici ---
# Supabase > Project Settings > Database > Connection string > « Transaction pooler » (port 6543).
# Vide = base SQLite locale dans data/prospection.db.
DATABASE_URL=
# Obligatoire en ligne : sans lui l'app refuse de s'ouvrir.
APP_PASSWORD=
